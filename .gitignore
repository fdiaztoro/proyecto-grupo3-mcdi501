# Entorno virtual
.venv/
__pycache__/
*.pyc

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store
.AppleDouble

# Config local del editor (rutas de LaTeX específicas de cada máquina/SO)
.vscode/

# Credenciales
.env

# Carpetas generadas por Anaconda/Jupyter
.virtual_documents/
anaconda_projects/

# Dataset original: solo se versiona la copia exacta usada en los informes (ver data/README.md),
# porque Kaggle puede entregar versiones distintas del mismo dataset.
data/raw/*
!data/raw/.gitkeep
!data/raw/framingham.csv

# Datos pesados y modelos
*.ckpt
*.pth

# Archivos de bloqueo temporal de Microsoft Office (se crean al abrir un .xlsx/.docx)
~$*

# Artefactos de compilación LaTeX en redaccion/ (el PDF final vive en informes/)
redaccion/**/*.aux
redaccion/**/*.log
redaccion/**/*.out
redaccion/**/*.toc
redaccion/**/*.synctex.gz
redaccion/**/*.fls
redaccion/**/*.fdb_latexmk
redaccion/**/informe.pdf
# Salida de scratch del notebook (no hace falta para compilar el informe)
informes/formativa-1-eda-inferencia/figuras/

# Notas sueltas en Markdown (se mantienen los README.md)
*.md
!**/README.md
